# ============================================================
# Clauthor — Environment variables (example)
# ============================================================
# Frontend (Vite) — expostas no bundle, seguras (RLS protege dados)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# ============================================================
# Backend (Edge Functions) — configuradas via `add_secret` na
# UI da Lovable Cloud (NÃO commit .env). Este bloco é apenas
# uma referência do que existe no ambiente server-side.
# ============================================================
# LOVABLE_API_KEY=            # gateway de IA (auto-provisionado)
# SUPABASE_SERVICE_ROLE_KEY=  # gerenciado pela Cloud
#
# --- WhatsApp Business (Meta Cloud API) ---
# WHATSAPP_ACCESS_TOKEN=      # Business Manager > System User token
# META_APP_SECRET=            # App Dashboard > Basic Settings > App Secret
#
# --- PayPal (produção) ---
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET_KEY=
#
# --- Integrações opcionais ---
# CLICKSIGN_ACCESS_TOKEN=
# DOCUSIGN_INTEGRATION_KEY=
# ELEVENLABS_API_KEY=
# FIRECRAWL_API_KEY=
# OPENCLAW_API_KEY=
# APP_URL=https://clauthor.com
