# ============================================================
# Clauthor, variáveis de ambiente
# Copie este arquivo para .env.local e preencha somente no seu ambiente.
# Nunca envie o arquivo preenchido ao repositório.
# ============================================================

# Frontend Vite, estas duas variáveis são públicas e entram no bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL pública do aplicativo.
APP_URL=https://clauthor.com

# ============================================================
# Backend, configure como secrets das Edge Functions.
# Nunca use prefixo VITE_ nestas variáveis.
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Integrações opcionais, sempre no backend.
# WHATSAPP_ACCESS_TOKEN=
# META_APP_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET_KEY=
# CLICKSIGN_ACCESS_TOKEN=
# DOCUSIGN_INTEGRATION_KEY=
# ELEVENLABS_API_KEY=
# FIRECRAWL_API_KEY=
# OPENCLAW_API_KEY=

# ============================================================
# Roteamento multi-provedor do Cloud Thor (Edge Functions)
# ============================================================
# Ordem: provedores configurados são tentados da esquerda para a direita.
# AI_ROUTER_ORDER=lovable,litellm,openrouter,openclaw
# AI_ROUTER_MODEL_LITELLM=provider/model-name
# AI_ROUTER_MODEL_OPENROUTER=provider/model-name:free

# LiteLLM ou gateway próprio compatível com OpenAI.
# LITELLM_BASE_URL=https://seu-gateway.example.com/v1
# LITELLM_API_KEY=

# OpenRouter opcional. Use chave com limite baixo no primeiro teste.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_FALLBACK_MODELS=provider/model-a:free,provider/model-b:free
