# ============================================================
# Clauthor · variáveis de ambiente
# Copie este arquivo para .env.local e preencha somente no ambiente.
# Nunca envie o arquivo preenchido ao repositório.
# ============================================================

# Frontend Vite — dados públicos, incluídos no bundle.
# Após vincular o Supabase em Mais → Banco de dados, use os valores
# fornecidos pelo projeto vinculado.
VITE_SUPABASE_URL=
# Use a chave pública/anon do projeto. Não use service_role no frontend.
VITE_SUPABASE_ANON_KEY=
# Alternativa compatível com a nomenclatura atual de chave pública:
# VITE_SUPABASE_PUBLISHABLE_KEY=

# URL pública canônica, usada nos links de confirmação e recuperação de senha.
APP_URL=https://clauthor.com

# ============================================================
# Backend — configure exclusivamente como secrets das Edge Functions.
# Nunca use prefixo VITE_ nestas variáveis e nunca as exponha ao navegador.
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Integrações opcionais, sempre no backend.
# WHATSAPP_ACCESS_TOKEN=
# META_APP_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET_KEY=
# CLICKSIGN_ACCESS_TOKEN=
# DOCUSIGN_INTEGRATION_KEY=
# ELEVENLABS_API_KEY=
# FIRECRAWL_API_KEY=
# OPENCLAW_API_KEY=

# ============================================================
# Roteamento de IA das Edge Functions
# Configure somente se o recurso correspondente estiver contratado e ativado.
# ============================================================
# AI_ROUTER_ORDER=
# AI_ROUTER_MODEL_LITELLM=
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
