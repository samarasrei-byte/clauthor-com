# ============================================================
# Clauthor, variáveis de ambiente
# Copie este arquivo para .env.local e preencha somente no seu ambiente.
# Nunca envie o arquivo preenchido ao repositório.
# ============================================================

# Frontend Vite, estas duas variáveis são públicas e entram no bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL pública do aplicativo.
APP_URL=https://clauthor.com

# ============================================================
# Backend, configure como secrets das Edge Functions.
# Nunca use prefixo VITE_ nestas variáveis.
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Integrações opcionais, sempre no backend.
# WHATSAPP_ACCESS_TOKEN=
# META_APP_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET_KEY=
# CLICKSIGN_ACCESS_TOKEN=
# DOCUSIGN_INTEGRATION_KEY=
# ELEVENLABS_API_KEY=
# FIRECRAWL_API_KEY=
# OPENCLAW_API_KEY=
